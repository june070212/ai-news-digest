<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Orders:RetentionDays" value="90" />
  </appSettings>
  <connectionStrings>
    <add name="Orders" connectionString="Server=.;Database=Orders;Integrated Security=true" />
  </connectionStrings>
  <system.web>
    <compilation targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" />
  </system.web>
</configuration>
